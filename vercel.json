{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; elif printf '%s' \"$VERCEL_GIT_COMMIT_MESSAGE\" | grep -Fq '[validate-preview]'; then exit 1; else exit 0; fi",
  "buildCommand": "node scripts/run-vercel-merge-gate.mjs && npm run build",
  "crons": [
    {
      "path": "/api/cron/notification-reconcile",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/wise-payment-reconcile",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sla-watch",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/track-shipments",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/authority-freshness",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/authority-monitor",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/cron/seo-search-console",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/governance",
      "schedule": "*/5 * * * *"
    }
  ]
}
