# ── SUPABASE (required) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# ── SITE ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── WISE ───────────────────────────────────────────────────────────────────────
# WISE_MODE switches the API host and webhook key used by lib/wise.ts:
#   test       → https://api.sandbox.transferwise.tech (no real funds move)
#   production → https://api.wise.com
WISE_MODE=test
WISE_API_TOKEN=your-wise-api-token
WISE_PROFILE_ID=12345678
# Override the sandbox webhook public key if Wise rotates it. Replace literal
# newlines with \n. Optional — a vetted default is hard-coded in lib/wise.ts.
# WISE_SANDBOX_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# Set to 1 to allow `x-signature-sha256: test-skip` on the webhook in sandbox
# only (handy for local replays). Never enable this in production.
# WISE_WEBHOOK_TEST_BYPASS=1

ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-token
TWILIO_FROM_NUMBER=+1...
