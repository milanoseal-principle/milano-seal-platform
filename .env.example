NEXT_PUBLIC_SITE_URL=https://themilanoseal.com
NEXT_PUBLIC_APP_URL=https://themilanoseal.com
PAYMENT_BASE_URL=https://themilanoseal.com

# Shippo customs declarant (international document shipments).
# Must be the full name of a person Milano has actually authorized to certify
# customs declarations as shipper of record. Never the client, and never a
# placeholder set only to unlock international quoting. When unset, customs
# declarations are not certified and rate quotes return CUSTOMS_REVIEW_REQUIRED.
SHIPPO_CUSTOMS_CERTIFY_SIGNER=

# Exact account-holder name on Milano's receiving Wise account, as Wise shows
# it (the DBA is not necessarily the account holder). Displayed to clients in
# Wise transfer instructions; when unset they see "As stated on your Milano
# invoice" rather than a guessed name.
NEXT_PUBLIC_WISE_BENEFICIARY_NAME=
