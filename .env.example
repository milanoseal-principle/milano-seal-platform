# Milano Seal production environment reference.
# Never commit real secret values. Keep server-only keys out of client bundles.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Public app URLs
NEXT_PUBLIC_SITE_URL=https://themilanoseal.com
NEXT_PUBLIC_APP_URL=https://themilanoseal.com
PAYMENT_BASE_URL=https://themilanoseal.com

# Email
RESEND_API_KEY=re_xxx
RESEND_FROM=The Milano Seal <hello@themilanoseal.com>
ADMIN_EMAILS=admin@themilanoseal.com
OPERATOR_EMAILS=admin@themilanoseal.com

# Wise payments
# Code reads WISE_ENV, WISE_API_TOKEN, WISE_PROFILE_ID, and WISE_WEBHOOK_ALLOWED_TEST.
# Wise API base URL is fixed in lib/wise.ts as https://api.wise.com.
# Wise webhook verification uses the baked-in RSA-SHA256 public key in lib/wise.ts.
WISE_ENV=production
WISE_API_TOKEN=xxx
WISE_PROFILE_ID=xxx
WISE_WEBHOOK_ALLOWED_TEST=false

# Non-production only. Must be unset in Vercel Production.
WISE_WEBHOOK_TEST_BYPASS=

# Legacy service helper only. The production /api/webhooks/wise route does not use HMAC.
WISE_WEBHOOK_SECRET=

# Shippo courier tracking
SHIPPO_API_KEY=shippo_live_xxx
SHIPPO_MODE=live
SHIPPO_WEBHOOK_SECRET=your-shippo-webhook-secret

# Scheduled jobs
CRON_SECRET=generate-a-32-char-random-string-here

# Portal session signing
# Generate with: openssl rand -hex 32
PORTAL_SESSION_SECRET=generate-a-64-char-hex-string-here

# AI services
ANTHROPIC_API_KEY=sk-ant-xxx
GROQ_API_KEY=gsk_xxx
OPENAI_API_KEY=sk-xxx
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
ANTHROPIC_INTAKE_MODEL=claude-sonnet-4-6
GROQ_INTAKE_MODEL=llama-3.1-8b-instant

# Twilio / WhatsApp
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+15550100
TWILIO_WHATSAPP_NUMBER=+14155238886
ADMIN_WHATSAPP=+1XXXXXXXXXX

# BlueNotary RON
BLUENOTARY_API_KEY=
BLUENOTARY_WEBHOOK_SECRET=
BLUENOTARY_MODE=test
BLUENOTARY_BASE_URL=https://app.bluenotary.us/api/integrationsv2
BLUENOTARY_DEFAULT_NOTARY_EMAIL=
BLUENOTARY_FINAL_DOCUMENT_DELIVERY_MODE=notary_manual

# Internal webhook bus (optional)
WEBHOOK_SECRET=generate-a-32-char-random-string-here
WEBHOOK_URL=https://themilanoseal.com/api/webhooks

# Production cleanup checklist: do not set Stripe keys, temporary passwords,
# MILANO_E2E_DEMO_MODE, ENABLE_DEBUG_SESSION, or WISE_WEBHOOK_TEST_BYPASS in Production.
