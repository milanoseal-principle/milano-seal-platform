NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
NEXT_PUBLIC_SITE_URL=https://themilanoseal.com
NEXT_PUBLIC_APP_URL=https://themilanoseal.com

RESEND_API_KEY=re_xxx
RESEND_FROM=The Milano Seal™ <hello@themilanoseal.com>

# Wise payment integration.
# WISE_ENV=production switches the webhook to production-strict mode
# (blocks test notifications, treats sandbox/test events as review-required).
# The Wise API base URL (https://api.wise.com) and the RSA-SHA256 webhook
# public key are built into the code (lib/wise.ts) — there is NO
# WISE_BASE_URL or WISE_WEBHOOK_PUBLIC_KEY env var to set.
WISE_ENV=production
WISE_API_TOKEN=xxx
WISE_PROFILE_ID=xxx
WISE_WEBHOOK_ALLOWED_TEST=false
# WISE_WEBHOOK_TEST_BYPASS — leave UNSET in production (non-prod test only).
PAYMENT_BASE_URL=https://themilanoseal.com

ANTHROPIC_API_KEY=sk-ant-xxx
GROQ_API_KEY=gsk_xxx

TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+15550100
TWILIO_WHATSAPP_NUMBER=+14155238886
ADMIN_WHATSAPP=+1XXXXXXXXXX

SHIPPO_API_KEY=shippo_live_xxx
SHIPPO_MODE=live

CRON_SECRET=generate-a-32-char-random-string-here

# SECURITY-06: Required for HMAC-signed portal session tokens.
# Generate with: openssl rand -hex 32
PORTAL_SESSION_SECRET=generate-a-64-char-hex-string-here


# Webhook secrets.
# NOTE: Wise webhooks are verified by RSA-SHA256 against the public key baked
# into lib/wise.ts — WISE_WEBHOOK_SECRET is not used by the Wise route and is
# kept here only for reference. Shippo uses the shared secret below (in the URL
# query string: ?secret=SHIPPO_WEBHOOK_SECRET).
WISE_WEBHOOK_SECRET=your-wise-webhook-secret
SHIPPO_WEBHOOK_SECRET=your-shippo-webhook-secret

# Operator notification targets (comma-separated emails).
# NOTE: founder release permission is granted by the Supabase auth role
# `founder_admin` (token metadata), NOT by an email allowlist. There is no
# FOUNDER_EMAILS env var.
OPERATOR_EMAILS=admin@themilanoseal.com
ADMIN_EMAILS=admin@themilanoseal.com

# Internal webhook bus (optional)
WEBHOOK_SECRET=generate-a-32-char-random-string-here
WEBHOOK_URL=https://themilanoseal.com/api/webhooks

# AI model overrides (optional — defaults apply if unset)
OPENAI_API_KEY=sk-xxx
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
ANTHROPIC_INTAKE_MODEL=claude-sonnet-4-6
GROQ_INTAKE_MODEL=llama-3.1-8b-instant

# BlueNotary RON — Remote Online Notarization (RON-01)
# SECURITY: BLUENOTARY_API_KEY and BLUENOTARY_WEBHOOK_SECRET are server-side only.
# Never expose these in client-side code or logs.
BLUENOTARY_API_KEY=
BLUENOTARY_WEBHOOK_SECRET=
BLUENOTARY_MODE=test
BLUENOTARY_BASE_URL=https://app.bluenotary.us/api/integrationsv2
BLUENOTARY_DEFAULT_NOTARY_EMAIL=
BLUENOTARY_FINAL_DOCUMENT_DELIVERY_MODE=notary_manual
